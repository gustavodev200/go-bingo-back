NODE_ENV=development
PORT=3333
# Local: Postgres do docker-compose. Produção: pooler do Supabase (DATABASE_URL, porta 6543) e conexão direta (DIRECT_URL, porta 5432).
DATABASE_URL=postgresql://bingo:bingo@localhost:5434/go_bingo
DIRECT_URL=postgresql://bingo:bingo@localhost:5434/go_bingo
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://<project-ref>.supabase.co
# true quando a app roda detrás de um reverse proxy/load balancer (ex.: em
# produção), para o Express confiar no X-Forwarded-For e o throttle de HTTP
# enxergar o IP real do cliente em vez do IP do proxy.
TRUST_PROXY=false

# Sentry (opcional; sem DSN o SDK fica desligado). Não deixe vazio: z.url() rejeita.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
