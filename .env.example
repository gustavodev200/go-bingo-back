NODE_ENV=development
PORT=3333
# Local: Postgres do docker-compose. Produção: pooler do Supabase (DATABASE_URL, porta 6543) e conexão direta (DIRECT_URL, porta 5432).
DATABASE_URL=postgresql://bingo:bingo@localhost:5434/go_bingo
DIRECT_URL=postgresql://bingo:bingo@localhost:5434/go_bingo
# Uma ou mais origens do front, separadas por vírgula (ex.: http://localhost:3000,https://app.exemplo.com).
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://<project-ref>.supabase.co
# true quando a app roda detrás de UM reverse proxy/load balancer (ex.: Fly), para
# o Express usar o IP que esse proxy acrescenta ao fim do X-Forwarded-For (1 hop;
# o resto do header é do cliente e não é confiável). Mais de um proxy = ajustar o hop em configure-app.ts.
TRUST_PROXY=false

# Sentry (opcional; sem DSN o SDK fica desligado). Vazio também é aceito (= desligado).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production

# Tempo padrão entre bolas (ms) das salas novas; o host pode escolher outro ao criar (4000–20000).
# DEFAULT_DRAW_INTERVAL_MS=8000

# Truco do Gu (mesas em memória). Janela de reconexão de um jogador caído (ms),
# pausa entre mãos (ms) e limite de mesas simultâneas.
# TRUCO_RECONNECT_GRACE_MS=60000
# TRUCO_HAND_PAUSE_MS=2500
# TRUCO_MAX_ROOMS=1000
# Dominó (namespace /domino), opcionais:
# DOMINO_RECONNECT_GRACE_MS=60000
# DOMINO_TURN_MS=25000
# DOMINO_ROUND_PAUSE_MS=5000
# DOMINO_MAX_ROOMS=1000
# Bomberman (namespace /bomber), opcionais:
# BOMBER_RECONNECT_GRACE_MS=30000
# BOMBER_ROUND_PAUSE_MS=3500
# BOMBER_MAX_ROOMS=300
# Infiltrado (namespace /infiltrado), opcionais:
# INF_RECONNECT_GRACE_MS=45000
# INF_MAX_ROOMS=200
# Snake.io (namespace /snake), opcionais:
# SNAKE_RECONNECT_GRACE_MS=30000
# SNAKE_MAX_ROOMS=200

# Chat de voz (WebRTC P2P). Servidores ICE entregues aos navegadores, em JSON.
# Sem isso usa só STUN público do Google; jogadores atrás de NAT restrito (4G,
# redes corporativas) precisam de um TURN para se ouvirem.
# VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemplo.com:3478","username":"u","credential":"p"}]
